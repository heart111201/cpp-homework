#include<stdio.h>
#include<iostream>
using namespace std;
int main()
{
   int a[10];
   cout<<"请输入十个整数:"<<endl;
   for(int i=0;i<10;i++)
   {
      cin>>a[i];
   }
   for(int m=0;m<9;m++)
   {
      for(int n=0;n<9-m;n++)
      {
         int t;
         if(a[n]>a[n+1])
         {
            t=a[n];a[n]=a[n+1];a[n+1]=t;
         }
      }
   }
   cout<<"排序后:"<<endl;
   for(int i=0;i<10;i++)
   {
      cout<<a[i]<<endl;
   }
   return 0;
}
